# Copy to .env.local and fill in. Never commit real values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=   # server and tests only; never expose to the browser
RECOVERY_COOKIE_SECRET=      # server only; signs the 15-minute password-recovery cookie (falls back to a key derived from the service role key)

# Canonical public origin used in auth emails (reset and confirm links), e.g. https://studiesphere.vercel.app
NEXT_PUBLIC_SITE_URL=
